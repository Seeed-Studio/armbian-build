 		};
 		opp-1416000000 {
 			opp-supported-hw = <0xf9 0xffff>;
@@ -496,6 +501,7 @@ opp-1416000000 {
 			opp-microvolt-L4 = <737500 737500 950000>;
 			opp-microvolt-L5 = <725000 725000 950000>;
 			clock-latency-ns = <40000>;
+			status = "disabled";
 		};
 		opp-1608000000 {
 			opp-supported-hw = <0xf9 0xffff>;
@@ -512,6 +518,7 @@ opp-1608000000 {
 			opp-microvolt-L9 = <725000 725000 950000>;
 			opp-microvolt-L10 = <712500 712500 950000>;
 			clock-latency-ns = <40000>;
+			status = "disabled";
 		};
 		opp-1800000000 {
 			opp-supported-hw = <0xf9 0xffff>;
@@ -529,6 +536,7 @@ opp-1800000000 {
 			opp-microvolt-L10 = <762500 762500 950000>;
 			clock-latency-ns = <40000>;
 			opp-suspend;
+			status = "disabled";
 		};
 		/* The Max frequency of RK3576S cluster0 is 1920MHz */
 		opp-s-1920000000 {
@@ -722,24 +730,28 @@ opp-408000000 {
 			opp-microvolt = <712500 712500 950000>;
 			clock-latency-ns = <40000>;
 			opp-suspend;
+			status = "disabled";
 		};
 		opp-600000000 {
 			opp-supported-hw = <0xf9 0xffff>;
 			opp-hz = /bits/ 64 <600000000>;
 			opp-microvolt = <712500 712500 950000>;
 			clock-latency-ns = <40000>;
+			status = "disabled";
 		};
 		opp-816000000 {
 			opp-supported-hw = <0xf9 0xffff>;
 			opp-hz = /bits/ 64 <816000000>;
 			opp-microvolt = <712500 712500 950000>;
 			clock-latency-ns = <40000>;
+			status = "disabled";
 		};
 		opp-1008000000 {
 			opp-supported-hw = <0xf9 0xffff>;
 			opp-hz = /bits/ 64 <1008000000>;
 			opp-microvolt = <712500 712500 950000>;
 			clock-latency-ns = <40000>;
+			status = "disabled";
 		};
 		opp-1200000000 {
 			opp-supported-hw = <0xf9 0xffff>;
@@ -750,6 +762,7 @@ opp-1200000000 {
