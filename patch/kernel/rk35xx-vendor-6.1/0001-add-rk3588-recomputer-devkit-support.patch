From 38455a818f73aae80142e97e2d8629574565ade7 Mon Sep 17 00:00:00 2001
From: ackPeng <1143590135@qq.com>
Date: Thu, 27 Nov 2025 16:21:20 +0800
Subject: [PATCH] add rk3588-recomputer-devkit support

---
 arch/arm64/boot/dts/rockchip/Makefile         |    1 +
 arch/arm64/boot/dts/rockchip/rk3576.dtsi      |   17 +
 .../arm64/boot/dts/rockchip/rk3588-linux.dtsi |    2 +-
 .../dts/rockchip/rk3588-recomputer-devkit.dts | 1340 +++++++++++++++++
 arch/arm64/boot/dts/rockchip/rk3588s.dtsi     |   71 +-
 5 files changed, 1422 insertions(+), 9 deletions(-)
 create mode 100644 arch/arm64/boot/dts/rockchip/rk3588-recomputer-devkit.dts

diff --git a/arch/arm64/boot/dts/rockchip/Makefile b/arch/arm64/boot/dts/rockchip/Makefile
index c3785f51b4c4..91bd7fadb576 100644
--- a/arch/arm64/boot/dts/rockchip/Makefile
+++ b/arch/arm64/boot/dts/rockchip/Makefile
@@ -448,6 +448,7 @@ dtb-$(CONFIG_ARCH_ROCKCHIP) += rk3588s-tablet-rk806-single-v10.dtb
 dtb-$(CONFIG_ARCH_ROCKCHIP) += rk3588s-tablet-v10.dtb
 dtb-$(CONFIG_ARCH_ROCKCHIP) += rk3588s-tablet-v11.dtb
 dtb-$(CONFIG_ARCH_ROCKCHIP) += rk3566-luckfox-core3566.dtb
 dtb-$(CONFIG_ARCH_ROCKCHIP) += rk3566-roc-pc.dtb
+dtb-$(CONFIG_ARCH_ROCKCHIP) += rk3588-recomputer-devkit.dtb
 
 subdir-y := $(dts-dirs) overlay
 
diff --git a/arch/arm64/boot/dts/rockchip/rk3576.dtsi b/arch/arm64/boot/dts/rockchip/rk3576.dtsi
