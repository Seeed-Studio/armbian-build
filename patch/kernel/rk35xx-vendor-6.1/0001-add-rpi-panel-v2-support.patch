+ /**
+  * struct drm_panel - DRM panel object
+  */
+ struct drm_panel {
+	 /**
+	  * @dev:
+	  *
+	  * Parent device of the panel.
+	  */
+	 struct device *dev;
+ 
+	 /**
+	  * @backlight:
